*{font-family:"Segoe UI","SF Pro Text","Ubuntu",Arial;font-size:13px;}QMainWindow,QWidget#root{background:#f4f7fb;color:#1f2937;}QMenuBar{background:#fff;border-bottom:1px solid #d6dde8;padding:3px;}QMenuBar::item{padding:6px 10px;border-radius:4px;}QMenuBar::item:selected{background:#e8f1ff;}QWidget#toolbar{background:#fff;border-bottom:1px solid #d6dde8;}QPushButton#toolButton{background:#fff;border:1px solid #d9e1ee;border-radius:8px;padding:6px;color:#111827;font-weight:600;}QPushButton#toolButton:hover{background:#eaf3ff;border:1px solid #8bbcff;}QWidget#pathBar{background:#f9fbff;border-bottom:1px solid #d6dde8;}QLabel#pathLabel{font-weight:600;color:#0f172a;}QLineEdit{background:#fff;border:1px solid #cbd5e1;border-radius:6px;padding:7px 10px;}QTreeWidget,QTableWidget{background:#fff;alternate-background-color:#f8fafc;border:none;gridline-color:#eef2f7;selection-background-color:#dbeafe;selection-color:#0f172a;}QHeaderView::section{background:#f1f5f9;color:#334155;border:none;border-right:1px solid #dbe3ee;border-bottom:1px solid #dbe3ee;padding:8px;font-weight:700;}QTableWidget::item,QTreeWidget::item{padding:6px;}QWidget#statusPanel{background:#fff;border-top:1px solid #d6dde8;}QProgressBar{background:#e5e7eb;border:none;border-radius:4px;height:8px;}QProgressBar::chunk{background:#3b82f6;border-radius:4px;}QSplitter::handle{background:#d6dde8;}