*{font-family:"Segoe UI","SF Pro Text","Ubuntu",Arial;font-size:13px;}QMainWindow,QWidget#root{background:#0b1220;color:#e5e7eb;}QMenuBar{background:#111827;color:#e5e7eb;border-bottom:1px solid #263244;padding:3px;}QMenuBar::item{padding:6px 10px;border-radius:4px;}QMenuBar::item:selected{background:#1e3a8a;}QMenu{background:#111827;color:#e5e7eb;border:1px solid #263244;}QMenu::item:selected{background:#1e40af;}QWidget#toolbar{background:#111827;border-bottom:1px solid #263244;}QPushButton#toolButton{background:#172033;border:1px solid #334155;border-radius:8px;padding:6px;color:#f8fafc;font-weight:600;}QPushButton#toolButton:hover{background:#1d4ed8;border:1px solid #60a5fa;}QWidget#pathBar{background:#0f172a;border-bottom:1px solid #263244;}QLabel#pathLabel{font-weight:600;color:#f8fafc;}QLineEdit{background:#020617;color:#e5e7eb;border:1px solid #334155;border-radius:6px;padding:7px 10px;}QTreeWidget,QTableWidget{background:#0b1220;alternate-background-color:#111827;color:#e5e7eb;border:none;gridline-color:#1f2937;selection-background-color:#1d4ed8;selection-color:#fff;}QHeaderView::section{background:#111827;color:#dbeafe;border:none;border-right:1px solid #263244;border-bottom:1px solid #263244;padding:8px;font-weight:700;}QTableWidget::item,QTreeWidget::item{padding:6px;}QWidget#statusPanel{background:#111827;color:#e5e7eb;border-top:1px solid #263244;}QProgressBar{background:#1f2937;border:none;border-radius:4px;height:8px;}QProgressBar::chunk{background:#3b82f6;border-radius:4px;}QSplitter::handle{background:#263244;}